# Copy to deploy/.env on the host. Never commit the real file.
# Image tag to run. Manual installs: a released version (e.g. 0.1.0) or `latest`.
# The GitHub Actions deploy job overrides this per run with the sha-<short> tag it built.
TABAYYUN_TAG=latest
# Public hostname for automatic TLS (leave empty to serve plain HTTP on :80)
TABAYYUN_DOMAIN=
# Both are required; the API refuses to start in prod with a "change-me" value or one
# shorter than 16 characters. Generate with: openssl rand -base64 36
POSTGRES_PASSWORD=change-me
TABAYYUN_SESSION_SECRET=change-me
# Password of `tabayyun_app`, the login the api and the worker use (spec 007); the api's
# migration step creates it. It sits inside a URL: generate with `openssl rand -hex 24`.
TABAYYUN_APP_DB_PASSWORD=change-me
# auto | on | off: hypertables when TimescaleDB is available, required, or never (ADR-0003)
TABAYYUN_TIMESCALE=auto
# Jobs a worker container runs at once (the compose bundle starts one worker; scale as needed)
TABAYYUN_WORKER_CONCURRENCY=2
# Sign-in (spec 013): the Keycloak realm made from deploy/keycloak/tabayyun-realm.json with
# deploy/keycloak/render.py <public url>. The api refuses to start in prod without these.
# The address people open, https, no path (e.g. https://tabayyun.example.com); redirect URIs
# and the CSRF origin check use it.
TABAYYUN_PUBLIC_URL=
# e.g. https://keycloak.example.com/realms/tabayyun
TABAYYUN_OIDC_ISSUER=
TABAYYUN_OIDC_CLIENT_ID=tabayyun-api
# Keycloak admin console → Clients → tabayyun-api → Credentials
TABAYYUN_OIDC_CLIENT_SECRET=
# Becomes owner at its first verified sign-in, while the org has no other owner.
TABAYYUN_ADMIN_EMAIL=
# Buttons on the sign-in page; each must be set up in the realm (Google and GitHub need OAuth apps).
TABAYYUN_SIGN_IN_METHODS=google,github,passkey
