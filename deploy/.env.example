# Copy to deploy/.env on the host. Never commit the real file.
TABAYYUN_TAG=latest
# Public hostname for automatic TLS (leave empty to serve plain HTTP on :80)
TABAYYUN_DOMAIN=
# Both are required; the API refuses to start in prod with a "change-me" value or one
# shorter than 16 characters. Generate with: openssl rand -base64 36
POSTGRES_PASSWORD=change-me
TABAYYUN_SESSION_SECRET=change-me
# Identity provider (Keycloak/Zitadel). Optional until the auth router ships; when set, a
# placeholder client secret is rejected.
TABAYYUN_OIDC_ISSUER=
TABAYYUN_OIDC_CLIENT_ID=
TABAYYUN_OIDC_CLIENT_SECRET=
