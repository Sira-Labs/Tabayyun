# Production edge for the compose bundle. TLS is terminated here when TABAYYUN_DOMAIN is set
# (Caddy obtains certificates automatically); otherwise it serves plain HTTP on :80 behind
# your own load balancer.
{
	servers {
		# Only the proxies in front of Caddy may tell it the client's address (X-Forwarded-For); strict
		# takes the rightmost address the proxy did not add itself, which a client cannot forge.
		# The image trusts private ranges, where CapRover's nginx sits (narrow it to the overlay
		# network's subnet); compose.yaml, where Caddy is the edge, trusts loopback only.
		trusted_proxies static {$TABAYYUN_TRUSTED_PROXIES:private_ranges}
		trusted_proxies_strict
	}
}

{$TABAYYUN_DOMAIN::80} {
	encode zstd gzip

	# Security headers (docs/frontend/02-security-baseline.md, spec 015); a test in
	# api/tests/test_edge_headers.py keeps them.
	header {
		# Strict, hash-free CSP: the SPA has no inline scripts or styles (React sets styles through
		# the DOM, which CSP allows); chart libraries are bundled.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
		# Browsers honour it over HTTPS only (CapRover or Caddy terminates TLS). No preload: that
		# covers the whole registered domain and is its owner's decision.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		-Server
	}

	@api path /api/* /healthz
	handle @api {
		reverse_proxy {$TABAYYUN_API_UPSTREAM:api:8000} {
			# The api keys sessions and per-IP rate limits (spec 015) on X-Real-IP; set it here so
			# a client cannot send its own.
			header_up X-Real-IP {client_ip}
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
