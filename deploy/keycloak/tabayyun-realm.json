{
  "realm": "tabayyun",
  "displayName": "Tabayyun",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "verifyEmail": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 10,
  "ssoSessionIdleTimeout": 43200,
  "ssoSessionMaxLifespan": 2592000,
  "accessTokenLifespan": 300,
  "browserFlow": "tabayyun browser",
  "firstBrokerLoginFlow": "tabayyun first broker login",
  "webAuthnPolicyPasswordlessRpEntityName": "Tabayyun",
  "webAuthnPolicyPasswordlessUserVerificationRequirement": "required",
  "webAuthnPolicyPasswordlessRequireResidentKey": "Yes",
  "webAuthnPolicyPasswordlessAuthenticatorAttachment": "not specified",
  "webAuthnPolicyPasswordlessAttestationConveyancePreference": "not specified",
  "webAuthnPolicyPasswordlessSignatureAlgorithms": [
    "ES256",
    "RS256"
  ],
  "requiredActions": [
    {
      "alias": "webauthn-register-passwordless",
      "name": "Passkey Register",
      "providerId": "webauthn-register-passwordless",
      "enabled": true,
      "defaultAction": false,
      "priority": 80,
      "config": {}
    }
  ],
  "clients": [
    {
      "clientId": "tabayyun-api",
      "name": "Tabayyun",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "consentRequired": false,
      "fullScopeAllowed": false,
      "rootUrl": "__PUBLIC_URL__",
      "baseUrl": "/",
      "redirectUris": [
        "__PUBLIC_URL__/api/auth/callback"
      ],
      "webOrigins": [
        "__PUBLIC_URL__"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "__PUBLIC_URL__/",
        "backchannel.logout.url": "__PUBLIC_URL__/api/auth/backchannel-logout",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "false",
        "id.token.signed.response.alg": "RS256"
      },
      "defaultClientScopes": [
        "basic",
        "email",
        "profile"
      ],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "identity provider",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "config": {
            "user.session.note": "identity_provider",
            "claim.name": "identity_provider",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "authentication method reference",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "false",
            "introspection.token.claim": "false"
          }
        }
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "google",
      "displayName": "Google",
      "providerId": "google",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "tabayyun first broker login",
      "config": {
        "clientId": "set-in-admin-console",
        "clientSecret": "set-in-admin-console",
        "defaultScope": "openid email profile",
        "syncMode": "IMPORT",
        "guiOrder": "1"
      }
    },
    {
      "alias": "github",
      "displayName": "GitHub",
      "providerId": "github",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "tabayyun first broker login",
      "config": {
        "clientId": "set-in-admin-console",
        "clientSecret": "set-in-admin-console",
        "defaultScope": "user:email",
        "syncMode": "IMPORT",
        "guiOrder": "2"
      }
    }
  ],
  "authenticationFlows": [
    {
      "alias": "tabayyun browser",
      "description": "Brokered sign-in (Google, GitHub) when the client names a provider, else the SSO cookie, else a passkey; no passwords.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "identity-provider-redirector",
          "requirement": "ALTERNATIVE",
          "priority": 5,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "tabayyun passkey",
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "autheticatorFlow": true,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "tabayyun passkey",
      "description": "Sign in with a discoverable passkey.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "webauthn-authenticator-passwordless",
          "authenticatorConfig": "tabayyun passkey amr",
          "requirement": "REQUIRED",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "tabayyun first broker login",
      "description": "Create the user, or link to the existing user with the same email; brokers are trusted for email (Google, GitHub verify it). No review page.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "idp-create-user-if-unique",
          "authenticatorConfig": "tabayyun create unique user",
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "idp-auto-link",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "tabayyun passkey amr",
      "config": {
        "default.reference.value": "passkey",
        "default.reference.maxAge": "120"
      }
    },
    {
      "alias": "tabayyun create unique user",
      "config": {
        "require.password.update.after.registration": "false"
      }
    }
  ]
}
