# Copy to .env for local development. Never commit .env.
TABAYYUN_ENV=dev
TABAYYUN_LOG_LEVEL=INFO
TABAYYUN_DATABASE_URL=postgresql+psycopg://tabayyun:tabayyun@localhost:5432/tabayyun
# auto | on | off: hypertables when TimescaleDB is available, required, or never (ADR-0003)
TABAYYUN_TIMESCALE=auto
# Set to run the database tests (`uv run pytest tests/db`); they skip when unset.
TABAYYUN_TEST_DATABASE_URL=postgresql+psycopg://tabayyun:tabayyun@localhost:5432/tabayyun
TABAYYUN_DB_POOL_SIZE=5
TABAYYUN_DB_POOL_MAX_OVERFLOW=10
# true: run jobs inside the API process (no worker needed); false: enqueue for `make worker-dev`
TABAYYUN_INLINE_JOBS=true
TABAYYUN_WORKER_CONCURRENCY=2
TABAYYUN_CACHE_DIR=./data/cache
# Identity provider (Keycloak realm or Zitadel project)
TABAYYUN_OIDC_ISSUER=
TABAYYUN_OIDC_CLIENT_ID=
TABAYYUN_OIDC_CLIENT_SECRET=
# 32+ random bytes, e.g. `openssl rand -base64 48`
TABAYYUN_SESSION_SECRET=
