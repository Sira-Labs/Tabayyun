# Copy to .env for local development. Never commit .env.
TABAYYUN_ENV=dev
TABAYYUN_LOG_LEVEL=INFO
TABAYYUN_DATABASE_URL=postgresql+psycopg://tabayyun:tabayyun@localhost:5432/tabayyun
TABAYYUN_CACHE_DIR=./data/cache
# Identity provider (Keycloak realm or Zitadel project)
TABAYYUN_OIDC_ISSUER=
TABAYYUN_OIDC_CLIENT_ID=
TABAYYUN_OIDC_CLIENT_SECRET=
# 32+ random bytes, e.g. `openssl rand -base64 48`
TABAYYUN_SESSION_SECRET=
